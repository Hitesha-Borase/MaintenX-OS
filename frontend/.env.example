# MAINTENX OS — FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Is file ko copy karke .env banao aur apni values bharo
# cp .env.example .env
# ==============================================================================

# -----------------------------------------------------------------------
# API / Backend
# -----------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1
# VITE_API_URL=https://mainten-x-os-production.up.railway.app/api/v1
VITE_WS_URL=ws://localhost:4000
VITE_APP_ENV=development
VITE_APP_NAME=MaintenX OS
VITE_APP_VERSION=1.0.0
VITE_APP_TAGLINE=Manufacturing Intelligence Platform

# -----------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------
VITE_AUTH_TOKEN_KEY=maintenx_auth_token
VITE_AUTH_PROFILE_KEY=flowstate_user_profile

# -----------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_AI=true
VITE_ENABLE_IOT_SIMULATOR=true
VITE_ENABLE_BILLING=true
VITE_ENABLE_EXECUTIVE_DASHBOARD=true
VITE_ENABLE_REALTIME_NOTIFICATIONS=false

# -----------------------------------------------------------------------
# Third-Party Integrations (Public Keys Only)
# -----------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# -----------------------------------------------------------------------
# Monitoring / Analytics (Optional)
# -----------------------------------------------------------------------
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------
# Misc UI Configuration
# -----------------------------------------------------------------------
VITE_DEFAULT_CURRENCY=INR
VITE_DEFAULT_CURRENCY_SYMBOL=₹
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_DEFAULT_PAGE_SIZE=25

