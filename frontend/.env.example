# ==============================================================================
# MAINTENX OS - FRONTEND ENVIRONMENT TEMPLATE (VITE)
# Copy this file to .env and adjust the values as needed
# ==============================================================================

# Backend API Configuration
VITE_API_URL=https://mainten-x-os-production.up.railway.app/api/v1

# WebSocket / Telemetry URL
VITE_WS_URL=ws://localhost:4000

# Application Metadata
VITE_APP_NAME=MaintenX OS
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Third-Party Integrations
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Mock Data Settings
VITE_ENABLE_MOCK_DATA=false
